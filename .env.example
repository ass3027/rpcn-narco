# Production Docker Compose settings. Copy this to .env on the production host.
# IMAGE_TAG is updated by the GitHub Actions deployment workflow.
ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPOSITORY=rpcn-narco
IMAGE_TAG=replace-with-a-commit-sha

# Absolute path on the production host. It must exist before deployment.
RPCN_DATA_PATH=/home/ubuntu/rpcn_data
